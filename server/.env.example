# ═══════════════════════════════════════════════════════════
# Configuration de l'API Calendrier
# Copie ce fichier en « .env » puis adapte les valeurs.
#   cp .env.example .env && nano .env
# ═══════════════════════════════════════════════════════════

# Port d'écoute local. Nginx fera le pont HTTPS vers ce port.
PORT=8787

# Interface d'écoute. Garde 127.0.0.1 : le service ne doit PAS être
# exposé directement sur Internet, c'est Nginx qui s'en charge.
HOST=127.0.0.1

# ⚠ OBLIGATOIRE — adresses autorisées à appeler l'API.
# Sans cette ligne, le navigateur bloquera toutes les requêtes.
# Mets l'URL EXACTE de ton GitHub Pages, sans barre oblique finale.
# Plusieurs valeurs possibles, séparées par des virgules.
ALLOWED_ORIGINS=https://TON-PSEUDO.github.io

# Autoriser la création de nouveaux comptes.
# Passe à false une fois TON compte créé : le serveur devient privé.
ALLOW_REGISTRATION=true

# Emplacement de la base SQLite (un seul fichier).
# Par défaut : server/data/calendrier.db
# DATA_DIR=/var/lib/calendrier

# Nombre maximum d'événements par compte.
MAX_EVENTS_PER_USER=20000
